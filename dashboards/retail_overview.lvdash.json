{
  "datasets": [
    {
      "name": "ds_daily_revenue",
      "displayName": "Daily revenue",
      "queryLines": [
        "SELECT order_date,\n",
        "       country,\n",
        "       channel,\n",
        "       category,\n",
        "       orders,\n",
        "       units,\n",
        "       revenue,\n",
        "       customers\n",
        "FROM workspace.retail_spike.gold_daily_revenue"
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Data quality",
      "queryLines": [
        "SELECT order_date,\n",
        "       reason,\n",
        "       rows\n",
        "FROM workspace.retail_spike.gold_quality_summary\n",
        "WHERE reason <> 'ok'"
      ]
    }
  ],
  "pages": [
    {
      "name": "page_overview",
      "displayName": "Overview",
      "layout": [
        {
          "widget": {
            "name": "kpi_revenue",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [{ "name": "sum(revenue)", "expression": "SUM(`revenue`)" }],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(revenue)",
                  "displayName": "Total revenue",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "AUD",
                    "abbreviation": "compact",
                    "decimalPlaces": { "type": "max", "places": 1 }
                  }
                }
              }
            }
          },
          "position": { "x": 0, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_orders",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [{ "name": "sum(orders)", "expression": "SUM(`orders`)" }],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(orders)",
                  "displayName": "Orders",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": { "type": "max", "places": 1 }
                  }
                }
              }
            }
          },
          "position": { "x": 2, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "kpi_units",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [{ "name": "sum(units)", "expression": "SUM(`units`)" }],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(units)",
                  "displayName": "Units sold",
                  "format": {
                    "type": "number-plain",
                    "abbreviation": "compact",
                    "decimalPlaces": { "type": "max", "places": 1 }
                  }
                }
              }
            }
          },
          "position": { "x": 4, "y": 0, "width": 2, "height": 3 }
        },
        {
          "widget": {
            "name": "revenue_over_time",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [
                    { "name": "daily(order_date)", "expression": "DATE_TRUNC('DAY', `order_date`)" },
                    { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "daily(order_date)",
                  "scale": { "type": "temporal" },
                  "displayName": "Date"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": { "type": "quantitative" },
                  "displayName": "Revenue"
                }
              },
              "frame": { "showTitle": true, "title": "Revenue over time" }
            }
          },
          "position": { "x": 0, "y": 3, "width": 4, "height": 6 }
        },
        {
          "widget": {
            "name": "revenue_by_channel",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [
                    { "name": "channel", "expression": "`channel`" },
                    { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "sum(revenue)",
                  "scale": { "type": "quantitative" },
                  "displayName": "Revenue"
                },
                "color": {
                  "fieldName": "channel",
                  "scale": { "type": "categorical" },
                  "displayName": "Channel"
                }
              },
              "frame": { "showTitle": true, "title": "Revenue by channel" }
            }
          },
          "position": { "x": 4, "y": 3, "width": 2, "height": 6 }
        },
        {
          "widget": {
            "name": "revenue_by_country",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [
                    { "name": "country", "expression": "`country`" },
                    { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "country",
                  "scale": { "type": "categorical" },
                  "displayName": "Country"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": { "type": "quantitative" },
                  "displayName": "Revenue"
                }
              },
              "frame": { "showTitle": true, "title": "Revenue by country" }
            }
          },
          "position": { "x": 0, "y": 9, "width": 3, "height": 6 }
        },
        {
          "widget": {
            "name": "revenue_by_category",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_daily_revenue",
                  "fields": [
                    { "name": "category", "expression": "`category`" },
                    { "name": "sum(revenue)", "expression": "SUM(`revenue`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "category",
                  "scale": { "type": "categorical" },
                  "displayName": "Category"
                },
                "y": {
                  "fieldName": "sum(revenue)",
                  "scale": { "type": "quantitative" },
                  "displayName": "Revenue"
                }
              },
              "frame": { "showTitle": true, "title": "Revenue by category" }
            }
          },
          "position": { "x": 3, "y": 9, "width": 3, "height": 6 }
        },
        {
          "widget": {
            "name": "quality_by_reason",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_quality",
                  "fields": [
                    { "name": "daily(order_date)", "expression": "DATE_TRUNC('DAY', `order_date`)" },
                    { "name": "reason", "expression": "`reason`" },
                    { "name": "sum(rows)", "expression": "SUM(`rows`)" }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "area",
              "encodings": {
                "x": {
                  "fieldName": "daily(order_date)",
                  "scale": { "type": "temporal" },
                  "displayName": "Date"
                },
                "y": {
                  "fieldName": "sum(rows)",
                  "scale": { "type": "quantitative" },
                  "displayName": "Rejected rows"
                },
                "color": {
                  "fieldName": "reason",
                  "scale": { "type": "categorical" },
                  "displayName": "Reason"
                }
              },
              "frame": { "showTitle": true, "title": "Rows failing quality checks, by reason" }
            }
          },
          "position": { "x": 0, "y": 15, "width": 6, "height": 6 }
        }
      ]
    }
  ]
}
