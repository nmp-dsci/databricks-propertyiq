{
  "datasets": [
    {
      "displayName": "Retrieval quality by contender (latest run)",
      "name": "ds_summary",
      "queryLines": [
        "SELECT contender,        avg(video_recall) AS recall_at_10,        avg(video_mrr) AS mrr,        avg(video_ndcg) AS ndcg_at_10,        avg(latency_s) AS latency_s FROM workspace.rag.rag_eval WHERE run_at = (SELECT max(run_at) FROM workspace.rag.rag_eval) GROUP BY contender"
      ]
    },
    {
      "displayName": "Metrics in long form for the grouped bar",
      "name": "ds_metric_long",
      "queryLines": [
        "WITH latest AS (   SELECT * FROM workspace.rag.rag_eval WHERE run_at = (SELECT max(run_at) FROM workspace.rag.rag_eval) ) SELECT contender, 'recall@10' AS metric, avg(video_recall) AS score FROM latest GROUP BY contender UNION ALL SELECT contender, 'MRR', avg(video_mrr) FROM latest GROUP BY contender UNION ALL SELECT contender, 'NDCG@10', avg(video_ndcg) FROM latest GROUP BY contender"
      ]
    },
    {
      "displayName": "Recall by question domain",
      "name": "ds_domain",
      "queryLines": [
        "SELECT domain, contender, avg(video_recall) AS recall_at_10 FROM workspace.rag.rag_eval WHERE run_at = (SELECT max(run_at) FROM workspace.rag.rag_eval) GROUP BY domain, contender"
      ]
    },
    {
      "displayName": "Per-question detail",
      "name": "ds_detail",
      "queryLines": [
        "SELECT case_id, domain, question_type, contender,        video_recall, video_mrr, video_ndcg, latency_s,        chunk_anchors_resolved, chunk_anchors_unresolved, retrieved_videos FROM workspace.rag.rag_eval WHERE run_at = (SELECT max(run_at) FROM workspace.rag.rag_eval) ORDER BY case_id, contender"
      ]
    },
    {
      "displayName": "Golden anchor health",
      "name": "ds_anchors",
      "queryLines": [
        "SELECT sum(chunk_anchors_resolved) / 3 AS resolved,        sum(chunk_anchors_unresolved) / 3 AS unresolved FROM workspace.rag.rag_eval WHERE run_at = (SELECT max(run_at) FROM workspace.rag.rag_eval)"
      ]
    },
    {
      "displayName": "Judged variant runs + dev goldens, question level",
      "name": "ds_judge",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT variant, max(run_at) AS run_at FROM workspace.rag.judge_scores WHERE mode = 'agentic' GROUP BY variant ",
        "), v AS ( ",
        "  SELECT s.variant, s.category, s.question_id, s.hops, s.unique_videos, ",
        "         s.composite, s.faithfulness, s.coverage, s.evidence_breadth ",
        "  FROM workspace.rag.judge_scores s JOIN latest l ON s.variant = l.variant AND s.run_at = l.run_at ",
        "  WHERE s.mode = 'agentic' ",
        "), g AS ( ",
        "  SELECT 'dev_golden' AS variant, category, question_id, iterations AS hops, ",
        "         NULL AS unique_videos, composite, faithfulness, coverage, evidence_breadth ",
        "  FROM workspace.rag.silver_golden_answers WHERE is_current ",
        ") ",
        "SELECT * FROM v UNION ALL SELECT * FROM g"
      ]
    },
    {
      "displayName": "Composite + hops by variant and stratum",
      "name": "ds_judge_summary",
      "queryLines": [
        "WITH latest AS ( ",
        "  SELECT variant, max(run_at) AS run_at FROM workspace.rag.judge_scores WHERE mode = 'agentic' GROUP BY variant ",
        "), v AS ( ",
        "  SELECT s.variant, s.category, avg(s.hops) AS hops, avg(s.composite) AS composite ",
        "  FROM workspace.rag.judge_scores s JOIN latest l ON s.variant = l.variant AND s.run_at = l.run_at ",
        "  WHERE s.mode = 'agentic' GROUP BY s.variant, s.category ",
        "), g AS ( ",
        "  SELECT 'dev_golden' AS variant, category, avg(iterations) AS hops, avg(composite) AS composite ",
        "  FROM workspace.rag.silver_golden_answers WHERE is_current GROUP BY category ",
        ") ",
        "SELECT * FROM v UNION ALL SELECT * FROM g"
      ]
    }
  ],
