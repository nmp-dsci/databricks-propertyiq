{
  "datasets": [
    {
      "name": "ds_sales",
      "displayName": "Monthly sales mart",
      "queryLines": [
        "SELECT postcode, suburb, property_type, area_band, zoning, month,\n",
        "       total_sale_value, n_sold, avg_sale_price, median_sale_price\n",
        "FROM workspace.propertyiq.gold_property_sales"
      ],
      "columns": [
        {
          "displayName": "Avg Sale Price",
          "description": "Weighted average: sum of sale value over sale count. Safe under any rollup.",
          "expression": "SUM(`total_sale_value`) / NULLIF(SUM(`n_sold`), 0)"
        },
        {
          "displayName": "Sales",
          "description": "Number of valid arms-length residential sales.",
          "expression": "SUM(`n_sold`)"
        }
      ]
    },
    {
      "name": "ds_rent",
      "displayName": "Monthly rent mart",
      "queryLines": [
        "SELECT postcode, property_type, bedroom_band, month,\n",
        "       total_weekly_rent, n_rented, avg_weekly_rent, median_weekly_rent\n",
        "FROM workspace.propertyiq.gold_property_rent"
      ],
      "columns": [
        {
          "displayName": "Avg Weekly Rent",
          "description": "Weighted average: sum of weekly rents over bond count.",
          "expression": "SUM(`total_weekly_rent`) / NULLIF(SUM(`n_rented`), 0)"
        },
        {
          "displayName": "Bonds",
          "description": "Number of valid bond lodgements.",
          "expression": "SUM(`n_rented`)"
        }
      ]
    },
    {
      "name": "ds_yield",
      "displayName": "Monthly yield mart",
      "queryLines": [
        "SELECT postcode, property_type, month,\n",
        "       total_sale_value, n_sold, total_weekly_rent, n_rented,\n",
        "       avg_sale_price, avg_weekly_rent, gross_yield_pct\n",
        "FROM workspace.propertyiq.gold_property_yield"
      ],
      "columns": [
        {
          "displayName": "Gross Yield Pct",
          "description": "52 x avg weekly rent / avg sale price x 100, recomputed from additive legs so it stays correct under any rollup.",
          "expression": "5200 * (SUM(`total_weekly_rent`) / NULLIF(SUM(`n_rented`), 0)) / NULLIF(SUM(`total_sale_value`) / NULLIF(SUM(`n_sold`), 0), 0)"
        }
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Data quality reasons",
      "queryLines": [
        "SELECT dataset, month, reason, rows\n",
        "FROM workspace.propertyiq.gold_quality_summary\n",
        "WHERE reason <> 'ok'"
      ]
    }
  ],
